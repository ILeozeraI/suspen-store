# Copie este arquivo para ".env.local" e preencha. O .env.local NÃO vai para o GitHub.

# Número do WhatsApp que recebe os pedidos (só números, com 55 + DDD)
NEXT_PUBLIC_WHATSAPP=5511968334426

# Endereço do site (usado nos links de retorno do pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API Keys). A "publishable key" é pública por natureza;
# quem protege os dados são as regras do banco (supabase/schema.sql).
# NUNCA coloque aqui a "secret key" / service_role: o site não precisa dela.
NEXT_PUBLIC_SUPABASE_URL=https://cwqgixyuzxtniasxvqkr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Liga o botão "Pagar no site". Deixe "false" até o Mercado Pago estar configurado.
NEXT_PUBLIC_PAGAMENTO_ONLINE=false

# Token de acesso do Mercado Pago (Painel do desenvolvedor > Suas integrações > Credenciais).
# Use primeiro a credencial de TESTE. Esta chave é secreta: nunca coloque no código.
MP_ACCESS_TOKEN=
