# Copie este arquivo para ".env.local" e preencha. O .env.local NÃO vai para o GitHub.
# Na Vercel: Settings > Environment Variables. As marcadas [SECRETA] vão como tipo "Secret".

# Número do WhatsApp que recebe os pedidos (só números, com 55 + DDD)
NEXT_PUBLIC_WHATSAPP=5511968334426

# Endereço do site (links de retorno e webhook). Na Vercel não precisa: o site descobre sozinho.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Project Settings > API Keys) ----------
NEXT_PUBLIC_SUPABASE_URL=https://cwqgixyuzxtniasxvqkr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [SECRETA] Chave secreta (sb_secret_...). Só o servidor usa: criar pedidos, confirmar pagamentos,
# calcular frete e criar login de fornecedor. Nunca no código, nunca no navegador.
SUPABASE_SECRET_KEY=

# ---------- Pagamento: Mercado Pago, Checkout Transparente ----------
# Liga o checkout. Deixe "false" até Mercado Pago, Melhor Envio e preços estarem prontos.
NEXT_PUBLIC_PAGAMENTO_ONLINE=false
# Mercado Pago > Suas integrações > (aplicação) > Credenciais. Use primeiro as de TESTE.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# [SECRETA]
MP_ACCESS_TOKEN=
# [SECRETA] Mercado Pago > Suas integrações > Webhooks > assinatura secreta
MP_WEBHOOK_SECRET=

# ---------- Frete: Melhor Envio ----------
# [SECRETA] Melhor Envio > Configurações > Permissões de acesso > Gerar token
ME_TOKEN=
# "sandbox" para testes ou "producao"
ME_AMBIENTE=sandbox
# E-mail técnico (o Melhor Envio exige)
ME_EMAIL_CONTATO=
# Só para testar no computador sem Melhor Envio: inventa preços de frete. NUNCA "true" na Vercel.
FRETE_SIMULADO=false
